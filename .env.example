# LendLoop environment variables — NAMES AND PLACEHOLDERS ONLY.
# Copy to `.env.local` for local development. Never commit real values.
# Exact variable names are confirmed against the SDK versions in the phase that adds them.

# --- App (Phase 1) ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (Phase 3) --------------------------------------------------------
# Publishable key is browser-safe. The secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Convex (Phase 4) -------------------------------------------------------
# Written by `npx convex dev`. CONVEX_DEPLOY_KEY is for CI/deployment only.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# CONVEX_DEPLOY_KEY=

# --- n8n (Phase 10+) --------------------------------------------------------
# These live in the Convex deployment environment and n8n credentials,
# not in the Next.js environment. Listed here for reference only.
# N8N_WEBHOOK_URL=
# N8N_SHARED_HMAC_SECRET=
